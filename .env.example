# Booking System Environment Configuration
# Copy this file to .env and update values for your environment

# ===================
# Application Config
# ===================
APP_PORT=3000

# ===================
# Database Config
# ===================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=booking_db
DB_PORT=3306

# ===================
# Redis Config
# ===================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===================
# JWT Authentication (Currently disabled - uncomment when implementing auth)
# ===================
# JWT_SECRET=your_secret_key_here
# JWT_EXPIRE=1h
# REFRESH_TOKEN_SECRET=your_refresh_token_secret
# REFRESH_TOKEN_EXPIRE=7d

# ===================
# Circuit Breaker Configuration
# ===================
# Percentage of failed requests (0.0-1.0) that triggers circuit to open
# Default: 0.5 (50% failure rate)
# Recommended: 0.3-0.5 for production, 0.7 for development
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5

# Number of recent requests to track for failure rate calculation
# Default: 20
# Recommended: 50-100 for high traffic, 10-20 for low traffic
CIRCUIT_BREAKER_WINDOW_SIZE=20

# Time in milliseconds to wait before attempting recovery (HALF_OPEN state)
# Default: 30000 (30 seconds)
# Recommended: 60000 (60s) for production, 10000 (10s) for development
CIRCUIT_BREAKER_TIMEOUT=30000

# Number of consecutive successful requests needed to close circuit from HALF_OPEN
# Default: 2
# Recommended: 2-3 for production, 1 for development
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# ===================
# Environment Presets
# ===================

# DEVELOPMENT PRESET (Fast recovery, less sensitive)
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.7
# CIRCUIT_BREAKER_WINDOW_SIZE=10
# CIRCUIT_BREAKER_TIMEOUT=10000
# CIRCUIT_BREAKER_SUCCESS_THRESHOLD=1

# PRODUCTION PRESET (Conservative, more stable)
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.3
# CIRCUIT_BREAKER_WINDOW_SIZE=50
# CIRCUIT_BREAKER_TIMEOUT=60000
# CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3

# HIGH TRAFFIC PRESET (Accurate failure detection)
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.4
# CIRCUIT_BREAKER_WINDOW_SIZE=100
# CIRCUIT_BREAKER_TIMEOUT=45000
# CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
